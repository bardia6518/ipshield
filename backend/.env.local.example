APP_NAME=IPShield
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ipshield_local
DB_USERNAME=ipshield_local
DB_PASSWORD=CHANGE_ME_LOCAL

SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=CHANGE_ME_LOCAL
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=ipshield:
CACHE_PREFIX=ipshield:cache:
REDIS_QUEUE=ipshield:queue:default
IPSHIELD_REDIS_CACHE_PREFIX=ipshield:cache:
IPSHIELD_REDIS_QUEUE_PREFIX=ipshield:queue:
IPSHIELD_REDIS_RATE_LIMIT_PREFIX=ipshield:rate-limit:
IPSHIELD_REDIS_LOCK_PREFIX=ipshield:lock:
IPSHIELD_REDIS_DEFAULT_TTL=300

FILESYSTEM_DISK=local
IPSHIELD_API_VERSION=v1
IPSHIELD_DEFAULT_TIMEZONE=UTC


REDIS_QUEUE_BLOCK_FOR=5
REDIS_QUEUE_AFTER_COMMIT=true
REDIS_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids
