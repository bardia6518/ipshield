APP_NAME=IPShield
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.ipshield.example
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=CHANGE_ME_PRODUCTION_DB_HOST
DB_PORT=5432
DB_DATABASE=ipshield_production
DB_USERNAME=ipshield_production
DB_PASSWORD=CHANGE_ME_PRODUCTION_DB_PASSWORD

SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=CHANGE_ME_PRODUCTION_REDIS_HOST
REDIS_PASSWORD=CHANGE_ME_PRODUCTION_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=ipshield:
CACHE_PREFIX=ipshield:cache:
REDIS_QUEUE=ipshield:queue:default
IPSHIELD_REDIS_CACHE_PREFIX=ipshield:cache:
IPSHIELD_REDIS_QUEUE_PREFIX=ipshield:queue:
IPSHIELD_REDIS_RATE_LIMIT_PREFIX=ipshield:rate-limit:
IPSHIELD_REDIS_LOCK_PREFIX=ipshield:lock:
IPSHIELD_REDIS_DEFAULT_TTL=300

FILESYSTEM_DISK=s3
IPSHIELD_API_VERSION=v1
IPSHIELD_DEFAULT_TIMEZONE=UTC

